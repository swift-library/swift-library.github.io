#!/usr/bin/env python3
"""Validate publication queuing and lint all remaining workflow fields."""

from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent


def publication_lint_input(source):
    block = re.search(r'^concurrency:\n((?:  [^\n]*\n)+)', source, re.M)
    if not block or '  queue: max\n' not in block[1] or '  cancel-in-progress: false\n' not in block[1]:
        raise ValueError('Publication requires queue: max and cancel-in-progress: false')
    if len(re.findall(r'^\s*queue:', source, re.M)) != 1:
        raise ValueError('Expected one publication queue declaration')
    # The released actionlint schema predates GitHub's queue field. Validate
    # that field above; its other syntax, expressions and actions stay linted.
    return source.replace('  queue: max\n', '', 1)


def main():
    workflows = ROOT / '.github/workflows'
    publication = workflows / 'publish.yml'
    output = ROOT / '.build/workflow-lint/publish.yml'
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(publication_lint_input(publication.read_text()))
    paths = [str(path) for path in sorted(workflows.glob('*.yml')) if path != publication]
    return subprocess.run(['actionlint', *paths, str(output)]).returncode


if __name__ == '__main__':
    raise SystemExit(main())
